# Django 配置
SECRET_KEY=django-insecure-your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# 数据库配置
DB_NAME=omnisolace
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# AI 服务配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Azure Speech 服务（语音识别）
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# 短信服务配置（用于紧急通知）
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number

# 邮件配置
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password

# 文件上传配置
MAX_UPLOAD_SIZE=10485760  # 10MB
MEDIA_ROOT=/path/to/media/files

# 安全配置
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/path/to/logs/django.log

# 缓存配置
CACHE_TTL=3600

# 限流配置
RATE_LIMIT_USER_CHAT=100/h
RATE_LIMIT_USER_GLOBAL=200/h
RATE_LIMIT_IP=1000/h

# 危机关键词（用分号分隔）
CRISIS_KEYWORDS=想死;自杀;结束生命;不想活;活着没意思;自伤;自残;伤害自己;想消失;解脱

# 数据保留设置
DATA_RETENTION_DAYS=90
CHAT_DESENSITIZATION_DAYS=7

# 开发环境特定设置
DJANGO_SETTINGS_MODULE=omnisolace.settings
