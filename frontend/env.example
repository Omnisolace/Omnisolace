# Omnisolace 环境变量配置示例
# 复制此文件为 .env.local 并根据实际情况修改配置

# 应用基础配置
VITE_APP_TITLE=Omnisolace
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=全年龄段AI心理疏导机器人

# API 配置
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT=10000

# 开发环境配置
VITE_DEV_PORT=5173
VITE_DEV_HOST=localhost

# 生产环境配置
VITE_PROD_BASE_URL=https://api.omnisolace.com

# 功能开关
VITE_ENABLE_MOCK=true
VITE_ENABLE_DEBUG=true
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE=true

# 第三方服务配置（可选）
# 百度语音识别 API
VITE_BAIDU_SPEECH_APP_ID=your_app_id
VITE_BAIDU_SPEECH_API_KEY=your_api_key
VITE_BAIDU_SPEECH_SECRET_KEY=your_secret_key

# 腾讯云语音识别 API
VITE_TENCENT_SECRET_ID=your_secret_id
VITE_TENCENT_SECRET_KEY=your_secret_key
VITE_TENCENT_REGION=ap-beijing

# 阿里云语音识别 API
VITE_ALIYUN_ACCESS_KEY_ID=your_access_key_id
VITE_ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
VITE_ALIYUN_REGION=cn-shanghai

# 心理健康相关配置
VITE_CRISIS_HOTLINE=400-161-9995
VITE_EMERGENCY_CONTACTS_MAX=5
VITE_SESSION_TIMEOUT=30

# 数据配置
VITE_DATA_RETENTION_DAYS=7
VITE_MAX_CHAT_HISTORY=100
VITE_MAX_FILE_SIZE=10485760

# 安全配置
VITE_ENABLE_ENCRYPTION=true
VITE_JWT_EXPIRE_TIME=3600
VITE_PASSWORD_MIN_LENGTH=6

# 老年模式配置
VITE_ELDER_FONT_SIZE=18
VITE_ELDER_BUTTON_SIZE=60
VITE_ELDER_VOICE_RATE=0.8

# 青少年模式配置
VITE_TEEN_PARENTAL_CONTROL=true
VITE_TEEN_CONTENT_FILTER=strict

# 分析和监控配置
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ID=your_analytics_id
VITE_ERROR_REPORTING=false
VITE_SENTRY_DSN=your_sentry_dsn

# 推送通知配置
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# 缓存配置
VITE_CACHE_TTL=3600000
VITE_STATIC_CACHE_VERSION=v1.0.0
VITE_DYNAMIC_CACHE_VERSION=v1.0.0

# 多语言配置
VITE_DEFAULT_LOCALE=zh-CN
VITE_AVAILABLE_LOCALES=zh-CN,en-US

# 主题配置
VITE_DEFAULT_THEME=light
VITE_AVAILABLE_THEMES=light,dark,elder,teen

# 开发工具配置
VITE_ENABLE_DEVTOOLS=true
VITE_MOCK_DELAY=1000
